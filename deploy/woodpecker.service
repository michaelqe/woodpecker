[Unit]
Description=Woodpecker woodworking designer (woodpecker.app.kennedy.ee)
After=network.target magpie.service

[Service]
Type=simple
User=michael
WorkingDirectory=/home/michael/woodpecker
EnvironmentFile=/home/michael/woodpecker/.env
ExecStart=/home/michael/woodpecker/.venv/bin/woodpecker serve --host 127.0.0.1 --port 8514
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
