{
  "title": "Carport for 2 cars with solar roof (6.6 x 6.0 m)",
  "description": "Option 1 for House > Garage (Proposed). Open timber carport at the house end of the pad, where it is deepest. Glulam posts on ground screws (no slab, pavers re-laid around them), glulam beams, 45x220 rafters, mono-pitch roof falling 5 degrees toward the garden, with room for about 15 solar panels (about 6.5 kWp). Roofed area about 39 m2: 20-60 m2 needs a building notice and design project, and the detailed plan (one building, 100 m2, realised) is the real hurdle. Posts and clear height are sized so walls and doors can be added later. Free-standing, 150 mm off the house wall. Sizes are a starting point for the designer, not a calculation.",
  "units": "mm",
  "anchored": "Stands on ground screws, so there is no tip check; the designer checks wind uplift and snow.",
  "params": {
    "x0": {
      "value": 150,
      "label": "Gap between house wall and roof edge"
    },
    "W": {
      "value": 6600,
      "label": "Roof width (along the house wall's side, x)"
    },
    "D": {
      "value": 5950,
      "label": "Roof depth, road side to garden side (y)"
    },
    "y0": {
      "value": 0,
      "label": "Roof front edge (0 = front edge of the pad)"
    },
    "bays": {
      "value": 2,
      "label": "Bays between posts",
      "unit": "count"
    },
    "h_front": {
      "value": 2900,
      "label": "Top of the front beam"
    },
    "pitch": {
      "value": 5,
      "label": "Roof pitch (falls toward the garden)",
      "unit": "deg"
    },
    "oh_side": {
      "value": 250,
      "label": "Roof overhang past the end posts"
    },
    "oh_front": {
      "value": 300,
      "label": "Roof overhang in front of the front posts"
    },
    "oh_back": {
      "value": 300,
      "label": "Roof overhang behind the back posts"
    },
    "post": {
      "value": 140,
      "label": "Post size (glulam, square)"
    },
    "beam_h": {
      "value": 225,
      "label": "Beam depth (glulam)"
    },
    "raf_h": {
      "value": 220,
      "label": "Rafter depth"
    },
    "raf_t": {
      "value": 45,
      "label": "Rafter thickness"
    },
    "raf_max": {
      "value": 600,
      "label": "Max rafter spacing"
    },
    "batten_max": {
      "value": 800,
      "label": "Max batten spacing (along the slope)"
    },
    "brace": {
      "value": 600,
      "label": "Knee brace leg"
    },
    "post_step": "(W - 2 * oh_side - post) / bays",
    "yf": "y0 + oh_front",
    "yb": "y0 + D - oh_back - post",
    "h_back": {
      "value": "h_front - (yb - yf) * tan(pitch)",
      "label": "Top of the back beam"
    },
    "raf_len": "D / cos(pitch)",
    "raf_n": "ceil((W - raf_t) / raf_max) + 1",
    "raf_step": "(W - raf_t) / (raf_n - 1)",
    "raf_z": "h_front + (yf + post / 2 - y0) * tan(pitch)",
    "top_z": "raf_z + raf_h / cos(pitch)",
    "bat_n": "ceil((raf_len - 100) / batten_max) + 1",
    "bat_step": "(raf_len - 100) / (bat_n - 1)",
    "roof_area_m2": {
      "value": "W * D / 1000000",
      "label": "Roofed area (counts as footprint)",
      "unit": "m2"
    },
    "height_max": {
      "value": "top_z + 32 + 25",
      "label": "Highest point (roof sheet at the front)"
    }
  },
